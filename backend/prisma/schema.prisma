datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  price       Float
  stars       Int
  imageUrl    String?
  cartItems   CartItem[]
  description String?
}

model CartItem {
  id        Int     @id @default(autoincrement())
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  quantity  Int
}